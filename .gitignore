# ──────────────────────────────────────────────
# NyayaSetu — .gitignore
# ──────────────────────────────────────────────

# ── SECRETS — NEVER commit these ─────────────
**/.env
**/.env.local
**/.env.*.local
**/.env.production
**/application-local.properties
**/application-secrets.properties
**/secrets.properties

# ── Node / Frontend ───────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.cache/
frontend/.parcel-cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Java / Spring Boot Backend ────────────────
backend/target/
backend/*.jar
backend/*.war
backend/.mvn/
*.class

# ── IDE / Editor ──────────────────────────────
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ── Python scripts / build artifacts ─────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/

# ── Misc ──────────────────────────────────────
.antigravityignore
reference-repo/
